# Environment: development, staging, production
NODE_ENV=development

# API Port
PORT=3000

# Database
DATABASE_URL=postgres://user:password@localhost:5432/thought_gps
DATABASE_POOL_SIZE=20

# Redis
REDIS_URL=redis://localhost:6379

# Caspian SDK
CASPIAN_API_KEY=your_caspian_api_key_here

# Channel Tokens
WHATSAPP_API_TOKEN=your_whatsapp_token
TELEGRAM_BOT_TOKEN=your_telegram_token
SLACK_BOT_TOKEN=your_slack_token
DISCORD_BOT_TOKEN=your_discord_token
SIGNAL_PHONE=your_signal_phone
EMAIL_ADDRESS=your_email@example.com

# Inference - Featherless.ai
FEATHERLESS_API_KEY=your_featherless_key
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1

# LLM Inference - Optional Fallbacks
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings
PINECONE_API_KEY=your_pinecone_key
PINECONE_INDEX_NAME=thought-gps

# Blockchain
CERAMIC_NODE_URL=https://mainnet.ceramic.network
IPFS_GATEWAY=https://gateway.pinata.cloud
ARWEAVE_KEY_FILE=path/to/arweave/key.json

# Security
SECRET_KEY=your_secret_key_for_encryption_min_32_chars

# Monitoring
SENTRY_DSN=your_sentry_dsn
PROMETHEUS_PORT=9090

# GitHub & Deployment
GITHUB_TOKEN=your_github_token
RENDER_API_KEY=your_render_api_key
RENDER_SERVICE_ID=your_render_service_id

# User API Keys Encryption
USER_API_KEYS_ENCRYPTION_KEY=your_32_char_encryption_key

# Logging
LOG_LEVEL=info

# Features
ENABLE_VOICE_MODE=true
ENABLE_BLOCKCHAIN=false
ENABLE_MONITORING=false
ENABLE_AUTO_SCALING=false
