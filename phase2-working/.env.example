# ==============================================================
# ReMentally - ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================
# Copy this file to .env and fill in your values.

# Core Application
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://your-production-domain.com

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://user:password@localhost:5432/rementally

# Security Secrets (Must be exactly 32 chars in production)
JWT_SECRET=super_secret_jwt_key_change_me_in_prod
API_KEY_ENCRYPTION_SECRET=32_char_secret_for_aes256_encryption!

# Notification System (VAPID for Browser Push)
VAPID_PUBLIC_KEY=generate_via_web-push
VAPID_PRIVATE_KEY=generate_via_web-push
VAPID_EMAIL=mailto:admin@your-domain.com

# PulseKit — Native Multi-Channel Messaging (built-in, no SDK needed)
# Configure global bots for automatic message routing.
# Users can also bring their own bot tokens via the Channels page.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
SLACK_BOT_TOKEN=xoxb-your-slack-token-here
DISCORD_BOT_TOKEN=your_discord_bot_token
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
SMTP_FROM=rementally@your-domain.com
# WhatsApp requires a Meta business account — optionally configure
WHATSAPP_PHONE_ID=your_whatsapp_phone_id
WHATSAPP_TOKEN=your_whatsapp_token
# Signal via self-hosted signal-cli REST API (optional)
SIGNAL_REST_URL=http://localhost:8080
SIGNAL_PHONE_NUMBER=+15551234567
SIGNAL_API_KEY=your_signal_gateway_key

# AI / LLM Providers (OpenAI is default)
OPENAI_API_KEY=sk-your-key-here
NVIDIA_API_KEY=nvapi-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Live Info / Agent-Reach (Optional for web scraping/search)
TAVILY_API_KEY=tvly-your-key-here
FIRECRAWL_API_KEY=fc-your-key-here

# Billing (Razorpay / Stripe)
RAZORPAY_KEY_ID=rzp_test_key
RAZORPAY_KEY_SECRET=rzp_test_secret

# Observability (Langfuse / Datadog)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
VITE_ENABLE_PAYMENTS=false
