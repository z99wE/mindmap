# ==============================================================
# THOUGHT GPS - ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================

# Core Application
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://your-production-domain.com

# Database (PostgreSQL with pgvector)
DATABASE_URL=postgresql://user:password@localhost:5432/thought_gps

# Security Secrets (Must be exactly 32 chars in production)
JWT_SECRET=super_secret_jwt_key_change_me_in_prod
API_KEY_ENCRYPTION_SECRET=32_char_secret_for_aes256_encryption!

# Notification System (VAPID for Browser Push)
VAPID_PUBLIC_KEY=generate_via_web-push
VAPID_PRIVATE_KEY=generate_via_web-push
VAPID_EMAIL=mailto:admin@your-domain.com

# Caspian SDK (Notification Router for Slack, Discord, Email, Telegram)
CASPIAN_API_KEY=your_caspian_key_here
CASPIAN_EMAIL_ENABLED=true
CASPIAN_SLACK_ENABLED=true
CASPIAN_DISCORD_ENABLED=true

# AI / LLM Providers (OpenAI is default)
OPENAI_API_KEY=sk-your-key-here
NVIDIA_API_KEY=nvapi-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Live Info / Agent-Reach (Optional for web scraping/search)
TAVILY_API_KEY=tvly-your-key-here
FIRECRAWL_API_KEY=fc-your-key-here

# Billing (Razorpay / Stripe)
RAZORPAY_KEY_ID=rzp_test_key
RAZORPAY_KEY_SECRET=rzp_test_secret

# Observability (Langfuse / Datadog)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
VITE_ENABLE_PAYMENTS=false
