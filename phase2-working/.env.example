# Thought GPS - Environment Variables
# Copy this file to .env and fill in your values

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://localhost:5432/thought_gps

# ── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-secret-string

# ── API Key Encryption ───────────────────────────────────────────────────────
API_KEY_ENCRYPTION_SECRET=change-this-to-a-random-32-char-string

# ── Shared LLM Key Pool (add multiple for round-robin) ──────────────────────
GROQ_API_KEY=
# GROQ_KEY_1=
# GROQ_KEY_2=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Langfuse Observability (optional, free tier) ────────────────────────────
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── Razorpay Payments (optional) ────────────────────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# ── RevenueCat (optional) ───────────────────────────────────────────────────
# REVENUECAT_API_KEY=
# REVENUECAT_WEBHOOK_SECRET=

# ── OmniRoute Admin (your personal keys) ────────────────────────────────────
# ADMIN_EMAIL=your-admin@email.com
# NVIDIA_API_KEY=
# GROK_API_KEY=

# ── Frontend URL (for CORS) ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Caspian SDK (multi-channel messaging) ────────────────────────────
# Setup (free, takes 30 seconds):
#   pip install caspian-cli
#   caspian init --name "thoughtgps-agent"    # mints key, writes CASPIAN_API_KEY to .env
#   caspian connect email                      # provisions a free agent email
#
# Required:
# CASPIAN_API_KEY=comm_sandbox_...            # minted via `caspian init`
# CASPIAN_BASE_URL=https://api.trycaspianai.com
#
# Free channels (connect any/all — $0, unlimited):
# CASPIAN_EMAIL_ENABLED=true                  # auto-provisions an agent email address
# CASPIAN_TELEGRAM_BOT_TOKEN=                 # bot token from @BotFather on Telegram
# CASPIAN_SLACK_ENABLED=false                 # enables one-click Slack OAuth install
# CASPIAN_DISCORD_ENABLED=false               # enables one-click Discord OAuth install
#
# Paid channels (disabled by default, opt-in only):
# CASPIAN_ENABLE_WHATSAPP=false
# CASPIAN_ENABLE_SMS=false

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
