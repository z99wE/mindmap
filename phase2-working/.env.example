# ==============================================================
# ReMentally - ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================
# Copy this file to .env and fill in your values.

# Core Application
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://your-production-domain.com

# ── Database (PostgreSQL — Render, Neon, Supabase, or local) ──────────────
# Render:    postgresql://user:pass@host:5432/dbname  (auto-set by Render)
# Neon:      postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
# Supabase:  postgresql://postgres.xxx:pass@aws-0-region.pooler.supabase.com:6543/postgres
# Local:     postgresql://user:password@localhost:5432/rementally
DATABASE_URL=postgresql://user:password@localhost:5432/rementally

# ── Security Secrets (Must be exactly 32 chars in production) ──────────────
JWT_SECRET=super_secret_jwt_key_change_me_in_prod
API_KEY_ENCRYPTION_SECRET=32_char_secret_for_aes256_encryption!

# ── Embedding Providers (multi-provider router with failover) ──────────────
# The embedding router tries providers in order: Groq → NVIDIA NIM → HuggingFace → OpenAI → hash fallback
# At least ONE real provider is needed for semantic memory search to work.
# All providers below have free tiers.
GROQ_API_KEY=gsk_your_groq_key_here           # Free: nomic-embed-text-v1_5 (768 dims)
NVIDIA_API_KEY=nvapi-your-nvidia-nim-key       # Free: 1000 req/day (nvidia/nv-embedqa-e5-v5)
HUGGINGFACE_API_KEY=hf_your_hf_token           # Free: rate-limited (all-MiniLM-L6-v2)
OPENAI_API_KEY=sk-your-key-here                # $0.02/1M tokens (text-embedding-3-small)

# ── LLM Providers (for thought processing) ────────────────────────────────
GROQ_KEY_1=gsk_your_groq_key_here             # Same key works for both embeddings + LLM
OPENAI_KEY_1=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-key-here
NVIDIA_API_KEY=nvapi-your-nvidia-nim-key       # Same key as embedding provider above

# ── Web Push (VAPID for Browser Push) ─────────────────────────────────────
VAPID_PUBLIC_KEY=generate_via_web-push
VAPID_PRIVATE_KEY=generate_via_web-push
VAPID_EMAIL=mailto:admin@your-domain.com

# ── Registration Gating ───────────────────────────────────────────────────
ALLOWED_ADMIN_EMAILS=
ALLOWED_BETA_EMAILS=

# ── Email (Resend) ────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_key
RESEND_SENDER_EMAIL=noreply@your-domain.com
RESEND_SENDER_NAME=ReMentally

# ── PulseKit Channels ─────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
SLACK_BOT_TOKEN=xoxb-your-slack-token-here
DISCORD_BOT_TOKEN=your_discord_bot_token
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
SMTP_FROM=rementally@your-domain.com
SIGNAL_REST_URL=http://localhost:8080
SIGNAL_PHONE_NUMBER=+15551234567
SIGNAL_API_KEY=your_signal_gateway_key

# ── Web Search (Agent Reach) ──────────────────────────────────────────────
TAVILY_API_KEY=tvly-your-key-here
FIRECRAWL_API_KEY=fc-your-key-here

# ── Billing ───────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_key
RAZORPAY_KEY_SECRET=rzp_test_secret

# ── Observability ─────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
VITE_ENABLE_PAYMENTS=false
