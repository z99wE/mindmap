{
  "globalDependencies": ["**/.env", "**/.env.local"],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": true,
      "outputs": ["coverage/**"],
      "inputs": ["src/**/*.ts", "**/*.test.ts", "jest.config.js"]
    },
    "test:coverage": {
      "cache": true,
      "outputs": ["coverage/**"]
    },
    "lint": {
      "cache": true,
      "outputs": [".eslintcache"]
    },
    "type-check": {
      "cache": true
    },
    "security:audit": {
      "cache": false
    }
  }
}
